// CRM Jurídico - Monique Advogados
// Adaptado para SQLite (sem enums do Prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  cpf               String?   @unique
  oab               String?
  phone             String?
  role              String    @default("ADVOGADO")
  isActive          Boolean   @default(true)
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  profileImage      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  casesResponsible  Case[]
  appointments      Appointment[]
  documents         Document[]
  auditLogs         AuditLog[]
  notes             Note[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Client {
  id            String   @id @default(uuid())
  name          String
  email         String?
  phone         String?
  cpfCnpj       String   @unique
  type          String
  address       String?
  city          String?
  state         String?
  zipCode       String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cases         Case[]
  contracts     Contract[]

  @@map("clients")
}

model Case {
  id              String     @id @default(uuid())
  caseNumber      String     @unique
  title           String
  description     String?
  type            String
  status          String     @default("ATIVO")
  court           String?
  jurisdiction    String?
  judge           String?
  value           Float?
  startDate       DateTime   @default(now())
  endDate         DateTime?
  clientId        String
  responsibleId   String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  client          Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  responsible     User       @relation(fields: [responsibleId], references: [id])
  parties         Party[]
  deadlines       Deadline[]
  hearings        Hearing[]
  documents       Document[]
  notes           Note[]
  fees            Fee[]
  appointments    Appointment[]
  expenses        Expense[]

  @@map("cases")
}

model Party {
  id        String   @id @default(uuid())
  name      String
  role      String
  cpfCnpj   String?
  lawyer    String?
  contact   String?
  caseId    String
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("parties")
}

model Deadline {
  id          String    @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  priority    String    @default("MEDIA")
  caseId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  case Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("deadlines")
}

model Hearing {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime
  location    String?
  type        String
  status      String   @default("AGENDADA")
  notes       String?
  caseId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("hearings")
}

model Document {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  version     Int      @default(1)
  caseId      String?
  uploadedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  case       Case?  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploader   User   @relation(fields: [uploadedBy], references: [id])

  @@map("documents")
}

model Appointment {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String
  startTime   DateTime
  endTime     DateTime
  location    String?
  participants String?
  userId      String
  caseId      String?
  isRecurring Boolean  @default(false)
  recurrence  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case?  @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model Fee {
  id          String    @id @default(uuid())
  description String
  amount      Float
  dueDate     DateTime
  paidDate    DateTime?
  status      String    @default("PENDENTE")
  type        String
  caseId      String
  installments Installment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("fees")
}

model Contract {
  id          String   @id @default(uuid())
  title       String
  description String?
  value       Float
  startDate   DateTime
  endDate     DateTime?
  status      String   @default("ATIVO")
  terms       String?
  filePath    String?
  clientId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

model Note {
  id        String   @id @default(uuid())
  content   String
  caseId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@map("notes")
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entity      String
  entityId    String?
  userId      String?
  ipAddress   String?
  userAgent   String?
  details     String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Template {
  id          String   @id @default(uuid())
  name        String
  description String?
  content     String
  category    String
  variables   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("templates")
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  userId    String
  link      String?
  createdAt DateTime @default(now())

  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// Módulo Financeiro
// ─────────────────────────────────────────────────────────────

/// Parcela de um honorário. É a unidade real de cobrança: o Fee guarda o
/// valor contratado e as parcelas guardam o que vence, quando e como foi pago.
model Installment {
  id          String    @id @default(uuid())
  number      Int
  amount      Float
  dueDate     DateTime
  paidDate    DateTime?
  status      String    @default("PENDENTE")
  method      String?
  reference   String?
  pixCode     String?
  notes       String?
  feeId       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  fee Fee @relation(fields: [feeId], references: [id], onDelete: Cascade)

  @@index([feeId])
  @@index([status, dueDate])

  @@map("installments")
}

/// Despesa e custo operacional do escritório
model Expense {
  id             String    @id @default(uuid())
  description    String
  category       String
  amount         Float
  dueDate        DateTime
  paidDate       DateTime?
  status         String    @default("PENDENTE")
  supplier       String?
  documentNumber String?
  notes          String?
  caseId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  case Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([status, dueDate])
  @@index([category])

  @@map("expenses")
}

/// Repasse de honorários a sócios. Guarda a referência do período para
/// que a comissão de um mês possa ser reconstitída e auditada depois.
model Repasse {
  id           String    @id @default(uuid())
  partnerName  String
  amount       Float
  referenceDate DateTime
  period       String?
  status       String    @default("PENDENTE")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([period])

  @@map("repasses")
}

/// Configurações do sistema em pares chave/valor (chave PIX, nome do
/// escritório, regras de comissão, etc.)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// Um código ou lei do vademecum. Guarda a procedência do texto porque o
/// advogado precisa saber de onde veio e quando foi conferido — é isso que
/// diferencia texto oficial de transcrição duvidosa.
model LegalCode {
  id          String    @id @default(uuid())
  sigla       String    @unique
  nome        String
  descricao   String?
  /// Sigla do ato, ex.: "Lei nº 13.105, de 16 de março de 2015"
  ato         String?
  fonteLabel  String
  fonteUrl    String
  importadoEm DateTime?
  artigoCount Int       @default(0)
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  artigos  LegalArticle[]
  secoes   LegalSection[]

  @@index([ativo])

  @@map("legal_codes")
}

/// Divisão do código (livro, título, capítulo, seção). Fica separada do
/// artigo para montar a navegação sem carregar o texto legal inteiro.
model LegalSection {
  id     String @id @default(uuid())
  rotulo String
  ordem  Int
  /// 1 = livro, 2 = título, 3 = capítulo, 4 = seção
  nivel  Int    @default(2)
  /// Caminho cumulativo, ex.: "I>II>1" — breadcrumb e ordenação estável
  path   String
  codeId String

  code    LegalCode      @relation(fields: [codeId], references: [id], onDelete: Cascade)
  artigos LegalArticle[]

  @@unique([codeId, path])
  @@index([codeId, ordem])

  @@map("legal_sections")
}

/// Um artigo do código. `numero` é texto e não inteiro porque a legislação
/// brasileira usa sufixos: "5-A", "198-A", "1º", "1.200".
model LegalArticle {
  id         String   @id @default(uuid())
  numero     String
  /// Epígrafe/ementa do artigo, quando existir
  rotulo     String?
  conteudo   String
  ordem      Int
  /// "Artigo revogado", "Artigo declarado inconstitucional pelo STF", etc.
  observacao String?
  /// Texto anterior vigente, para o caso de o artigo ter mudado de redação
  textoAnterior String?
  codeId     String
  sectionId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  code    LegalCode     @relation(fields: [codeId], references: [id], onDelete: Cascade)
  section LegalSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([codeId, numero])
  @@index([codeId, ordem])
  @@index([sectionId])

  @@map("legal_articles")
}
